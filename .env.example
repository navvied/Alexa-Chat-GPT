# Copy to .env and fill in. Never commit .env.

# --- Alexa -------------------------------------------------------------------
# Alexa Developer Console > your skill > Build > Endpoint ("Your Skill ID").
ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
# Path the reverse proxy forwards to this service.
ALEXA_PATH=/alexa
# Only for local tests without Alexa. Never set this to true on a public server.
ALEXA_SKIP_VERIFICATION=false

# --- ChatGPT (OpenAI API) ---------------------------------------------------
# Create a key at https://platform.openai.com/api-keys (billed per use; a ChatGPT
# Plus/Pro subscription does not cover the API).
OPENAI_API_KEY=
# chat-latest = the model ChatGPT itself currently uses.
OPENAI_MODEL=chat-latest
# Any OpenAI-compatible server works too.
OPENAI_BASE_URL=https://api.openai.com/v1
# Upper limit per answer. 0 = no limit.
OPENAI_MAX_OUTPUT_TOKENS=600
# Optional: only for reasoning models that accept it (for example: low).
OPENAI_REASONING_EFFORT=
# Optional: 0 to 2. Leave empty for the model default.
OPENAI_TEMPERATURE=
OPENAI_TIMEOUT_MS=60000

# --- Behaviour ----------------------------------------------------------------
# Leave empty for the built-in prompt. Use \n for a new line.
SYSTEM_PROMPT=
# Used to tell ChatGPT today's date and time.
TIMEZONE=Asia/Jakarta
# How long to wait before saying "say continue" (Alexa allows 8 seconds in total).
ANSWER_DEADLINE_MS=6000
# Say "Let me think." if the answer takes longer than this. 0 = never.
PROGRESSIVE_AFTER_MS=1500
# Question-and-answer pairs remembered per conversation.
MAX_HISTORY_TURNS=10
SESSION_IDLE_MINUTES=30
MAX_SESSIONS=500
MAX_SPEECH_CHARS=6000
# true = write every question and answer to the log.
LOG_CONVERSATIONS=false

# --- Server -------------------------------------------------------------------
# 127.0.0.1 = reachable only through the reverse proxy (recommended).
HOST=127.0.0.1
PORT=8787
